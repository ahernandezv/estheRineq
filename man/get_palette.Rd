\name{get_palette}
\alias{get_palette}
\title{Retrieve Editorial Colorblind-Safe Palettes}
\description{
Returns hex color vectors for Pelotas, Lancet, Okabe-Ito, and WHO palettes.
}
\usage{
get_palette(name = "pelotas", n = 5L)
}
\arguments{
  \item{name}{Character string identifier for a standard population or color palette.}
  \item{n}{Integer number of observations or palette colors.}
}
\value{
A character vector of hexadecimal colors.
}

